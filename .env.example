# Скопируйте в .env и заполните. Файл .env не коммитится.

# ── MAX ─────────────────────────────────────────────────────────────────────
# Токен бота из платформы MAX для партнёров. Передаётся только в заголовке Authorization.
MAX_BOT_TOKEN=
# Username бота для deep link https://max.ru/<username>?startapp=... (если пусто — берётся из GET /me)
MAX_BOT_USERNAME=
# polling — локальная разработка (без HTTPS); webhook — прод; off — бот выключен
MAX_UPDATES_MODE=polling
# Для webhook: публичный HTTPS-адрес сервера (порт 443) и секрет (A-Z a-z 0-9 _ -, 5–256 символов)
PUBLIC_BASE_URL=
MAX_WEBHOOK_SECRET=
# link — кнопка-ссылка на deep link; open_app — кнопка open_app
MAX_OPEN_APP_BUTTON=link

# ── Приложение ──────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
# Работа mini-app в обычном браузере без MAX (демо). В проде — false.
ALLOW_BROWSER_DEMO=true
# Загружать ручную тестовую базу при старте
SEED_ON_START=true
# Считать ручную тестовую базу достаточной для фильтра «нужны документы» (только демо)
DEMO_TRUST_MANUAL_DATA=true
# Демонстрация частичного отказа: id адаптеров через запятую (например FSA_DECL,SME_REGISTRY)
SIMULATE_SOURCE_FAILURES=
SEARCH_TOKEN_TTL_SEC=900
DATA_RETENTION_DAYS=180
RATE_LIMIT_PER_MIN=120

# ── Порты на хосте (docker compose) ─────────────────────────────────────────
# Меняйте, если порт уже занят другим сервисом (например, локальным PostgreSQL)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
APP_HOST_PORT=8080
# Токен для /metrics и /admin/metrics (не короче 16 символов)
ADMIN_TOKEN=

# ── Инфраструктура (docker compose задаёт сам) ──────────────────────────────
POSTGRES_PASSWORD=supplier
# DATABASE_URL=postgres://supplier:supplier@localhost:5432/supplier
# REDIS_URL=redis://localhost:6379

# ── Реальные данные ─────────────────────────────────────────────────────────
# real — только официальные открытые данные (после импорта), test — ручная тестовая база, all — обе
SEARCH_DATA=real
# Регионы импорта из реестра МСП: пусто — вся Россия, иначе коды через запятую (например 77,50)
OPENDATA_REGIONS=
# Витрины ГИСП (доступ по заявке организации). Пути — из паспорта витрины, {inn} подставляется
GISP_API_BASE=
GISP_JWT=
GISP_PRODUCTS_PATH=
GISP_PP719_PATH=
# ЕГРЮЛ/ЕГРИП по API DaData: ключ из личного кабинета dadata.ru (бесплатно, до 10 000 запросов в сутки).
# Запрашивается только для лучших кандидатов выдачи и открытых карточек, хранится EGRUL_MAX_AGE_DAYS дней
DADATA_API_KEY=
EGRUL_MAX_AGE_DAYS=7
EGRUL_TOP_CANDIDATES=10

# ── GigaChat (понимание запроса и объяснение выдачи) ───────────────────────
# ИИ разбирает запрос («фанера ФСФ 18 мм, Москва») и упорядочивает уже найденных в реестрах поставщиков,
# объясняя выбор цитатой из документа. Факты он не добавляет; без ключа поиск работает на правилах.
# Ключ: developers.sber.ru → личный кабинет → проект GigaChat API → «Получить ключ» (это «Ключ авторизации»,
# Base64 от Client ID:Client Secret).
GIGACHAT_ENABLED=true
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — физлицо; GIGACHAT_API_B2B — ИП/юрлицо с пакетом токенов; GIGACHAT_API_CORP — с оплатой по факту
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_API_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Одновременных запросов к GigaChat: физлицу доступен 1 поток, юрлицу — до 10
GIGACHAT_MAX_CONCURRENCY=1
# Сколько ждать ответа ИИ во время поиска; дольше — выдача без ИИ
GIGACHAT_TIMEOUT_MS=4000
# Сколько лучших кандидатов ИИ оценивает и объясняет
GIGACHAT_RERANK_TOP=30
