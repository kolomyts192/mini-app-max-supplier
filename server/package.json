{
  "name": "proveren-postavshik-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend «Проверенный поставщик»: MAX-бот, API мини-приложения, поиск и адаптеры источников",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --dir test/e2e",
    "gen:data": "tsx scripts/generate-test-data.ts",
    "opendata": "tsx src/opendata/cli.ts",
    "max:me": "tsx scripts/max-cli.ts me",
    "max:webhook:set": "tsx scripts/max-cli.ts webhook:set",
    "max:webhook:list": "tsx scripts/max-cli.ts webhook:list",
    "max:webhook:delete": "tsx scripts/max-cli.ts webhook:delete"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "fastify": "^5.3.2",
    "ioredis": "^5.6.1",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "yauzl": "^3.2.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.14",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
